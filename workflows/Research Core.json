    {
      "parameters": {
        "jsCode": "// 1. EXTRACT ALL ARTICLES FROM NESTED ARRAYS\nlet flatData = [];\nconst items = $input.all();\n\nitems.forEach(item => {\n  const data = item.json;\n  // Unpack Hacker News (hits) or SerpApi (news_results)\n  if (data.hits && Array.isArray(data.hits)) flatData.push(...data.hits); \n  else if (data.news_results && Array.isArray(data.news_results)) flatData.push(...data.news_results); \n  else flatData.push(data); \n});\n\n// 2. CREATE A UNIQUE LIST BY URL\nconst uniqueList = Array.from(new Map(flatData.map(item => [item.url || item.link, item])).values());\n\n// 3. GENERATE PROMPTS FOR OLLAMA\n// We return an array of objects so the next node (Ollama) runs for EACH article\nreturn uniqueList.map(article => {\n  const title = article.title || article.story_title || \"Untitled\";\n  const snippet = article.snippet || article.story_text || article.contentSnippet || \"No snippet available\";\n  \n  const ollamaPrompt = `\nYou are a senior technical editor for an elite Frontend Engineering newsletter. \nGrade this news item from 1 to 100 based on its importance to Senior Frontend Engineers and AI developers.\n\nCRITERIA:\n- 90-100: Major industry shifts or research (e.g., Hugging Face Spring Report, Claude 3.7 Release).\n- 70-89: High-signal technical deep dives, new SDKs, or architecture patterns.\n- 40-69: Minor tool updates or general technical news.\n- 0-39: Personal projects (\"Show HN\"), vague blogs, keyboards, or non-technical fluff.\n\nARTICLE TITLE: ${title}\nSNIPPET: ${snippet}\n\nINSTRUCTION: Respond with ONLY a single number. No text.\n  `;\n\n  return {\n    json: {\n      title: title,\n      url: article.url || article.link,\n      source: article.source?.name || article.source || \"Industry Source\",\n      prompt: ollamaPrompt\n    }\n  };\n});"
      },
