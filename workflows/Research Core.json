    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 1. Get ALL articles from the previous data preparation node\n// Replace \"Code in JavaScript\" with the exact name of the node that created the prompt\nconst allOriginalArticles = $(\"Code in JavaScript\").all();\n\nreturn items.map((item, index) => {\n  // 2. Extract the score from Ollama's response\n  const ollamaResponse = item.json.response || \"0\";\n  const numericScore = parseInt(ollamaResponse.trim().replace(/[^0-9]/g, ''), 10) || 0;\n\n  // 3. Match by index\n  // item[0] of this batch matches article[0] of the previous node, etc.\n  const originalArticle = allOriginalArticles[index].json;\n\n  return {\n    json: {\n      title: originalArticle.title,\n      url: originalArticle.url,\n      source: originalArticle.source || \"Industry Intelligence\",\n      score: numericScore,\n      // Ensure date is in a format Postgres likes (ISO)\n      date: originalArticle.date ? new Date(originalArticle.date).toISOString() : new Date().toISOString()\n    }\n  };\n});"
      },
