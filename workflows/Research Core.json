    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet allArticles = [];\n\nconst sevenDaysAgo = Math.floor(Date.now() / 1000) - 604800;\n\nconst targets = ['claude', 'cursor', 'copilot', 'ollama', 'deepseek', 'agent', 'windsurf', 'hugging face', 'openai', 'anthropic'];\nconst improvementSignals = ['improvement', 'faster', 'release', 'update', 'optimized', 'performance', 'benchmark', 'launch', 'new'];\n\nitems.forEach(item => {\n  const data = item.json;\n  \n  // 1. FRESHNESS CHECK\n  let timestamp = data.created_at_i || (data.date || data.pubDate ? Math.floor(new Date(data.date || data.pubDate).getTime() / 1000) : null);\n  \n  // Strict 7-day cutoff\n  if (!timestamp || timestamp < sevenDaysAgo) return;\n\n  // 2. CONTENT SCORING\n  let title = (data.title || data.story_title || \"\").toLowerCase();\n  let snippet = (data.snippet || data.contentSnippet || \"\").toLowerCase();\n  let content = title + \" \" + snippet;\n\n  // Kill the \"keyboard\" and \"humor\" noise\n  if (content.includes('keyboard') || content.includes('joke')) return;\n\n  let score = 0;\n  targets.forEach(t => { if (content.includes(t)) score += 10; });\n  improvementSignals.forEach(s => { if (content.includes(s)) score += 10; });\n\n  // 3. QUALITY GATE\n  if (score >= 10 && title.length > 20) {\n    allArticles.push({\n      title: data.title || data.story_title,\n      url: data.url || data.link || (data.objectID ? `https://news.ycombinator.com/item?id=${data.objectID}` : \"\"),\n      source: data.source?.name || data.source || (data.objectID ? \"Hacker News\" : \"Technical Pulse\"),\n      date: new Date(timestamp * 1000).toLocaleDateString(),\n      score: score\n    });\n  }\n});\n\nreturn allArticles\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 6)\n  .map((art, i) => ({ json: { id: i + 1, ...art } }));"
      },
