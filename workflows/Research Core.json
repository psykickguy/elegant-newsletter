    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 👇 this must match EXACT node name\nconst allOriginalArticles = $(\"Code in JavaScript\").all();\n\nreturn items.map((item, index) => {\n  // 1. Extract score\n  const ollamaResponse = item.json.response || \"0\";\n  const numericScore =\n    parseInt(ollamaResponse.trim().replace(/[^0-9]/g, ''), 10) || 0;\n\n  // 2. Get original article\n  const originalArticle = allOriginalArticles[index].json;\n\n  // 🔥 TWITTER PENALTY\n  let penalty = 0;\n  if (\n    originalArticle.url &&\n    originalArticle.url.includes(\"twitter.com\")\n  ) {\n    penalty = 10;\n  }\n\n  // 🔥 FINAL SCORE\n  const finalScore =\n    numericScore +\n    (originalArticle.freshnessBoost || 0) -\n    penalty;\n\n  return {\n    json: {\n      title: originalArticle.title,\n      url: originalArticle.url,\n      linkLabel: originalArticle.linkLabel,\n      source: originalArticle.source || \"Industry Intelligence\",\n\n      // ✅ FINAL SCORE\n      score: finalScore,\n\n      // 🧠 DEBUG (optional but VERY useful)\n      baseScore: numericScore,\n      freshnessBoost: originalArticle.freshnessBoost || 0,\n      penaltyApplied: penalty,\n\n      // DB safe date\n      date: originalArticle.date\n        ? new Date(originalArticle.date).toISOString()\n        : new Date().toISOString()\n    }\n  };\n});"
      },
