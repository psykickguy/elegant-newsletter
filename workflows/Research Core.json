    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet allArticles = [];\n\n// THE \"ELITE\" TARGETS\nconst targets = ['claude', 'cursor', 'copilot', 'ollama', 'deepseek', 'agent'];\n\n// CLIENT REQUIREMENT: Improvement & Seriousness\nconst improvementSignals = ['improvement', 'faster', 'release', 'update', 'new feature', 'optimized', 'performance', 'benchmark', 'productivity'];\n\nconst rawResults = items[0].json.news_results || [];\n\nrawResults.forEach(article => {\n  let title = (article.title || \"\").toLowerCase();\n  let snippet = (article.snippet || \"\").toLowerCase();\n  \n  let sourceName = \"\";\n  if (typeof article.source === 'string') sourceName = article.source;\n  else if (article.source && article.source.name) sourceName = article.source.name;\n  \n  let content = title + \" \" + snippet;\n  let score = 0;\n\n  // 1. IMPROVEMENT FILTER (Mandatory weight)\n  improvementSignals.forEach(s => {\n    if (content.includes(s)) score += 12;\n  });\n\n  // 2. TOOL RELEVANCE\n  targets.forEach(t => {\n    if (content.includes(t)) score += 10;\n  });\n\n  // 3. SOURCE AUTHORITY\n  const authoritySources = ['techcrunch', 'wired', 'the verge', 'venturebeat', 'bloomberg', 'zdnet'];\n  if (authoritySources.some(s => sourceName.toLowerCase().includes(s))) score += 8;\n\n  // STRICT THRESHOLD: Must mention an improvement or a major tool\n  if (score > 18 && title.length > 35) {\n    allArticles.push({\n      title: article.title,\n      url: article.link,\n      source: sourceName,\n      date: article.date,\n      category: \"Frontend Evolution\",\n      score: score\n    });\n  }\n});\n\nreturn allArticles\n  .sort((a, b) => b.score - a.score)\n  .slice(0, 6)\n  .map((art, i) => ({ json: { id: i + 1, ...art } }));"
      },
