    {
      "parameters": {
        "jsCode": "// 🔥 HELPERS (TOP - CORRECT)\nconst getBestUrl = (article) => {\n  return (\n    article.status_link ||\n    article.twitter_url ||\n    article.link ||\n    article.url ||\n    article.source_url ||\n    null\n  );\n};\n\nconst getLinkLabel = (url) => {\n  if (!url) return \"Read More\";\n  if (url.includes(\"github.com\")) return \"View GitHub Repo\";\n  if (url.includes(\"twitter.com\")) return \"View Discussion\";\n  if (url.includes(\"youtube.com\")) return \"Watch Demo\";\n  return \"Read Full Breakdown\";\n};\n\n\n// 1. EXTRACT ALL ARTICLES\nlet flatData = [];\nconst items = $input.all();\n\nitems.forEach(item => {\n  const data = item.json;\n\n  if (data.hits && Array.isArray(data.hits)) {\n    flatData.push(...data.hits);\n  } \n  else if (data.news_results && Array.isArray(data.news_results)) {\n    flatData.push(...data.news_results);\n  } \n  else if (data.tweets && Array.isArray(data.tweets)) {\n    flatData.push(...data.tweets);\n  } \n  else {\n    flatData.push(data);\n  }\n});\n\n\n// 2. UNIQUE LIST\nconst uniqueList = Array.from(\n  new Map(\n    flatData.map(item => [\n      item.url || item.link || item.twitter_url || item.status_link,\n      item\n    ])\n  ).values()\n);\n\n\n// 3. GENERATE PROMPTS + FIXED URL LOGIC\nreturn uniqueList\n  .map(article => {\n\n    const title =\n      article.title ||\n      article.text ||\n      article.story_title ||\n      \"Untitled\";\n\n    const snippet =\n      article.snippet ||\n      article.text ||\n      article.story_text ||\n      article.contentSnippet ||\n      \"No snippet available\";\n\n    if (!title || title.length < 20) return null;\n\n    // ✅ FIXED URL LOGIC (INSIDE MAP)\n    const url = getBestUrl(article);\n\n    // ❌ FILTER BAD LINKS\n    if (!url || url.includes(\"search\") || url.includes(\"google.com\")) {\n      return null;\n    }\n\n    // 🔥 FRESHNESS BOOST\n    const now = Date.now();\n    const articleDate = new Date(\n      article.date ||\n      article.publishedAt ||\n      article.created_at ||\n      now\n    ).getTime();\n\n    const ageHours = (now - articleDate) / (1000 * 60 * 60);\n\n    let freshnessBoost = 0;\n    if (ageHours < 24) freshnessBoost = 10;\n    else if (ageHours < 72) freshnessBoost = 5;\n\n    const ollamaPrompt = `\nYou are a senior AI developer newsletter curator.\n\nEvaluate this content for:\n- Real-world developer usage\n- Productivity improvement\n- Emerging tools or trends\n- Signal vs noise\n\nGive HIGH scores if:\n- Copilot / Claude / Cursor workflows\n- Automation or dev acceleration\n- Real developer impact\n\nGive LOW scores if:\n- Generic blogs\n- Marketing fluff\n\nReject content that is:\n- motivational\n- opinion-only\n- not showing real implementation, workflow, or technical insight\n\nTITLE: ${title}\nSNIPPET: ${snippet}\n\nRespond ONLY with a number from 0 to 100.\n`;\n\n    return {\n      json: {\n        title: title,\n        url: url,\n\n        linkLabel: getLinkLabel(url), // 🔥 NOW WORKS CORRECTLY\n\n        source:\n          article.source?.name ||\n          article.source ||\n          article.user?.name ||\n          \"Industry Source\",\n\n        prompt: ollamaPrompt,\n        freshnessBoost: freshnessBoost,\n        date: article.date || article.publishedAt || article.created_at || null\n      }\n    };\n  })\n  .filter(Boolean);"
      },
